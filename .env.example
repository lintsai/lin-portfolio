# ==========================================
# Lin Tsai AI Assistant - 環境變數設定
# ==========================================

# Groq API Key (請至 https://console.groq.com/keys 免費申請)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 使用之 LLM 模型 (預設推薦 llama-3.3-70b-versatile 或 llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile
